# Copy to .env and set every required secret before running Docker Compose.
# Secret fields are intentionally empty; never commit the populated .env file.
DB_URL=jdbc:mysql://127.0.0.1:3306/yuelin_local_life?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia%2FShanghai&characterEncoding=utf8
DB_USERNAME=yuelin
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=yuelin
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
YUELIN_MESSAGING_ENABLED=true

# Comma-separated user IDs allowed to create or update shops and vouchers. Empty denies all.
YUELIN_ADMIN_USER_IDS=
YUELIN_IMAGE_DIR=./data/images

# Optional reliable-seckill tuning
SECKILL_RECONCILE_INITIAL_DELAY_MS=30000
SECKILL_RECONCILE_INTERVAL_MS=30000
SECKILL_RECONCILE_TIMEOUT_MS=60000
SECKILL_RECONCILE_BATCH_SIZE=100
SECKILL_RECONCILE_MAX_RETRIES=3
SECKILL_AUDIT_INITIAL_DELAY_MS=60000
SECKILL_AUDIT_INTERVAL_MS=60000
SECKILL_REQUEST_RATE_PER_SECOND=1000

LOG_LEVEL=info
